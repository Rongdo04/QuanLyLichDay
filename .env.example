# Chép file này thành ".env" (cùng thư mục) rồi sửa. File .env không được đưa lên GitHub.

# Siêu quản trị: không nằm trong database, luôn đăng nhập được, toàn quyền quản lý tài khoản.
# Mật khẩu ít nhất 10 ký tự. Muốn giấu mật khẩu gốc thì chạy
#   npm run tai-khoan -w server -- bam <mật khẩu>
# rồi dán dòng nó in ra vào đây thay cho dòng SIEU_QUAN_TRI_MAT_KHAU bên dưới.
SIEU_QUAN_TRI_TEN=admin
SIEU_QUAN_TRI_MAT_KHAU=doi-mat-khau-nay-ngay
